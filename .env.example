CHAT2API_HOST=0.0.0.0
CHAT2API_PORT=8765
CHAT2API_ADMIN_USERNAME=admin
CHAT2API_ADMIN_PASSWORD=replace-with-a-strong-console-password
CHAT2API_ADMIN_SESSION_HOURS=24
CHAT2API_PUBLIC_URL=https://chat2api.example.com
CHAT2API_DATA_DIR=data
CHAT2API_REQUEST_TIMEOUT_SECONDS=300
CHAT2API_DESKTOP_WAKE_TIMEOUT_SECONDS=45
CHAT2API_ALLOWED_ORIGINS=*

# Deprecated migration inputs only. They are not accepted for administrator login
# or business API calls after v0.17. Existing installations may keep them for one
# upgrade so old API-key ciphertext / legacy pairing code can migrate.
# CHAT2API_API_KEY=old-master-key
# CHAT2API_PAIRING_CODE=old-pairing-code
