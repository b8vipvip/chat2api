{
  "manifest_version": 3,
  "name": "chat2api Chrome Bridge",
  "version": "0.8.0",
  "description": "Turns logged-in ChatGPT browser tabs into a concurrent remotely callable text, multimodal, image-generation and realtime Voice API bridge.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "alarms", "downloads"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": { "service_worker": "background_entry.js" },
  "action": { "default_title": "chat2api", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["voice_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "content_page_adapter_v22.js",
        "content_login_v27.js",
        "content_page_driver_v22.js",
        "content_request_v2.js",
        "content_model.js",
        "content_model_v3.js",
        "content_model_v4.js",
        "content_model_v5.js",
        "content_model_fast_v21.js",
        "content_model_cache_migrate_v7.js",
        "content_model_v7.js",
        "content_model_transition_v15.js",
        "content_reasoning_v7.js",
        "content_page_smoke_v22.js",
        "content_multimodal.js",
        "content_request_v3.js",
        "content_multimodal_v4.js",
        "content_request_v4.js",
        "content_request_v5.js",
        "content_request_perf_v21.js",
        "content_completion_v6.js",
        "content_completion_fast_v21.js",
        "content_reasoning_transport_v20.js",
        "content_format_v20.js",
        "content_account_v20.js",
        "content_guard.js",
        "content_image.js",
        "content_image_v3.js",
        "content_voice.js",
        "content_voice_v2.js",
        "content_voice_fix_v3.js",
        "content_voice_fix_v4.js",
        "content_runtime_log.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
