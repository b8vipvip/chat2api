{
  "manifest_version": 3,
  "name": "chat2api Chrome Bridge",
  "version": "0.6.5",
  "description": "Turns a logged-in ChatGPT browser tab into a remotely callable text, multimodal, image-generation and Voice API bridge.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": { "service_worker": "background_entry.js" },
  "action": { "default_title": "chat2api", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["voice_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "content_request_v2.js",
        "content_model.js",
        "content_model_v3.js",
        "content_model_v4.js",
        "content_model_v5.js",
        "content_model_v6.js",
        "content_multimodal.js",
        "content_request_v3.js",
        "content_guard.js",
        "content_image.js",
        "content_voice.js",
        "content_voice_v2.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
