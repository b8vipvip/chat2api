{
  "manifest_version": 3,
  "name": "chat2api Worker",
  "version": "0.8.16",
  "description": "Turns logged-in ChatGPT browser tabs into a concurrent remotely callable chat2api Worker for text, multimodal, image-generation and realtime Voice requests.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "alarms", "downloads", "contentSettings"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": { "service_worker": "background_entry.js" },
  "action": { "default_title": "chat2api Worker", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["voice_main.js", "network_stream_main_v55.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "content_bundle_marker_v48.js",
        "content_page_adapter_v22.js",
        "content_login_v27.js",
        "content_ui_hygiene_v31.js",
        "content_rate_limit_guard_v52.js",
        "content_tool_isolation_v48.js",
        "content_page_driver_v22.js",
        "content_request_v2.js",
        "content_model.js",
        "content_model_v3.js",
        "content_model_v4.js",
        "content_model_v5.js",
        "content_model_fast_v21.js",
        "content_model_cache_migrate_v7.js",
        "content_model_v7.js",
        "content_model_transition_v15.js",
        "content_reasoning_v7.js",
        "content_page_smoke_v22.js",
        "content_multimodal.js",
        "content_multimodal_quota_v36.js",
        "content_request_v3.js",
        "content_multimodal_v68.js",
        "content_multimodal_v4.js",
        "content_request_v4.js",
        "content_request_v5.js",
        "content_request_lifecycle_v50.js",
        "content_request_hygiene_v42.js",
        "content_draft_ownership_v43.js",
        "content_draft_managed_recovery_v55.js",
        "content_response_capture_v41.js",
        "content_response_stream_recovery_v49.js",
        "content_network_stream_recovery_v55.js",
        "content_response_semantic_recovery_v51.js",
        "content_transient_retry_v50.js",
        "content_request_stall_guard_v34.js",
        "content_generation_liveness_v49.js",
        "content_request_perf_v21.js",
        "content_completion_v6.js",
        "content_completion_fast_v21.js",
        "content_reasoning_transport_v20.js",
        "content_format_v20.js",
        "content_account_v20.js",
        "content_guard.js",
        "content_image.js",
        "content_image_v3.js",
        "content_voice.js",
        "content_voice_v2.js",
        "content_voice_fix_v3.js",
        "content_voice_fix_v4.js",
        "content_runtime_log.js",
        "content_runtime_contract_v48.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
